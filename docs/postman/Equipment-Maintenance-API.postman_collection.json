            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ветротурбина ВЭУ-2026\",\n  \"type\": \"wind_turbine\",\n  \"serialNumber\": \"{{testSerialNumber}}\",\n  \"location\": {\n    \"lat\": 55.751244,\n    \"lon\": 37.618423\n  },\n  \"status\": \"operational\",\n  \"installedAt\": \"2024-05-15T08:00:00.000Z\"\n}"
