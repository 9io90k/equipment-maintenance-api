        {
          "name": "5. Get Equipment Weather Forecast",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or gateway error without server crash', function () {",
                  "    pm.expect([200, 502, 503, 504]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Contains forecast structure and thresholds', function () {",
                  "        pm.expect(json.data).to.have.property('forecast');",
                  "        pm.expect(json.data).to.have.property('safetyThresholds');",
                  "        pm.expect(Array.isArray(json.data.forecast)).to.be.true;",
                  "        if (json.data.forecast.length > 0) {",
                  "            pm.expect(json.data.forecast[0]).to.have.property('isSuitableForOutdoorWork');",
                  "        }",
                  "    });",
