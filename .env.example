# Server configuration
PORT=3000
NODE_ENV=development

# Security & CORS
# Comma-separated list of allowed origins (e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Weather API (Open-Meteo from Case 1)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Weather safety thresholds for outdoor work
# Maximum wind speed in m/s allowed for outdoor work
WEATHER_MAX_WIND_SPEED=12.0
# Maximum precipitation in mm allowed for outdoor work
WEATHER_MAX_PRECIPITATION=0.5

# Logging
LOG_LEVEL=debug
