PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WEATHER_MAX_WIND_SPEED=12.0
WEATHER_MAX_PRECIPITATION=0.5
LOG_LEVEL=debug

# PostgreSQL, Docker
POSTGRES_DB=equipment_db
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# Connect app to DB
PGHOST=localhost
PGPORT=5432
PGDATABASE=equipment_db
PGUSER=app
PGPASSWORD=secret

# Database Connection Pool
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Authentication & JWT
JWT_ACCESS_SECRET=your-256-bit-access-secret-here
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10